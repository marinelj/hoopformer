/* Compact: the court as large as the screen allows, the coaching in thumb reach. Portrait stacks them; landscape puts
   the court on the left and the coaching column on the right (the page turns with the phone). Sizes in px, so the
   rows stay the same size in either orientation. */
.page { display: flex; flex-direction: column; height: 100vh; overflow: hidden;
        padding: 6px 6px env(safe-area-inset-bottom); box-sizing: border-box; }
.page.landscape { flex-direction: row; gap: 6px; padding: 6px max(6px, env(safe-area-inset-right)) 6px max(6px, env(safe-area-inset-left)); }
.error { padding: 16px; color: #ff8a7a; }

/* the score */
.stage { flex: none; display: flex; flex-direction: column; gap: 4px; }
.board { display: flex; align-items: center; justify-content: space-between; height: 34px; padding: 0 8px; border-radius: 8px; background: #07090d; border: 1px solid #222a37; }
.team { display: flex; align-items: center; gap: 6px; }
.stripe { width: 4px; height: 22px; border-radius: 2px; }
.code { font-weight: 700; font-size: 14px; letter-spacing: 1px; }
.pts { font-weight: 800; font-size: 22px; color: #ffb23e; min-width: 34px; text-align: center; font-variant-numeric: tabular-nums; }
.clocks { display: flex; align-items: baseline; gap: 6px; font-variant-numeric: tabular-nums; }
.period { font-size: 10px; color: #8892a6; }
.clock { font-size: 18px; font-weight: 800; color: #ffb23e; }
.shot { font-size: 11px; color: #ff6a55; }

/* the court */
.court-box { position: relative; border-radius: 8px; overflow: hidden; }
.court { display: block; }
.banner { position: absolute; left: 50%; top: 12%; transform: translateX(-50%); padding: 4px 12px; border-radius: 6px;
          background: rgba(7, 9, 13, 0.85); color: #ffb23e; font-weight: 800; letter-spacing: 1px; }
.callout { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%) scale(0.9); max-width: 86%; padding: 6px 12px;
           border-radius: 8px; background: rgba(7, 9, 13, 0.92); border: 2px solid #3ddc84; opacity: 0; transition: all 0.2s;
           display: flex; flex-direction: column; align-items: center; text-align: center; }
.callout.show { opacity: 1; transform: translate(-50%, -50%) scale(1); }
.callout.bad { border-color: #ff5a47; }
.callout .big { font-weight: 800; font-size: 16px; color: #3ddc84; }
.callout.bad .big { color: #ff5a47; }
.callout .small { font-size: 11px; color: #c7cfdb; margin-top: 2px; }
.strip { height: 22px; line-height: 22px; padding: 0 6px; border-radius: 6px; background: #07090d; color: #ffb23e; font-size: 11px;
         overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* the coaching */
.panel { flex: 1; min-height: 0; display: flex; flex-direction: column; margin-top: 6px; }
.landscape .panel { margin-top: 0; }
.controls { flex: none; display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
.play { flex: none; padding: 0 14px; height: 36px; line-height: 36px; border-radius: 8px; background: #ffb23e; color: #15120c; font-weight: 800; }
.play.resume { background: #3ddc84; }
.play.off { opacity: 0.45; }
.tabs { flex: 1; display: flex; border: 1px solid #222a37; border-radius: 8px; overflow: hidden; }
.tab { flex: 1; text-align: center; height: 34px; line-height: 34px; color: #8892a6; }
.tab.on { background: #1a2130; color: #ffb23e; font-weight: 700; }
.body { flex: 1; min-height: 0; border: 1px solid #222a37; border-radius: 8px; background: #0e1219; }
.body.lit { border-color: #ffb23e; box-shadow: 0 0 10px rgba(255, 178, 62, 0.35); }
.phase { padding: 6px 8px 2px; font-size: 11px; color: #8fc7ff; }
.lock { color: #8892a6; }

.row { display: flex; align-items: center; gap: 4px; padding: 4px 6px; border-bottom: 1px solid #1a2130; }
.who { width: 78px; flex: none; display: flex; flex-direction: column; overflow: hidden; }
.nm { font-weight: 700; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.team-row .nm { color: #ffb23e; }
.kind { font-size: 9px; color: #8892a6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pick { flex: 1; min-width: 0; }
.pick-face { height: 30px; line-height: 30px; padding: 0 6px; border-radius: 6px; background: #151b26; border: 1px solid #262f3f;
             font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pick-face.tactic { border-color: #ffb23e; color: #ffb23e; }
.pick-face.locked { opacity: 0.55; }
.icon { flex: none; width: 30px; height: 30px; line-height: 30px; text-align: center; border-radius: 6px; background: #1a2130; border: 1px solid #262f3f; }
.helper { padding: 8px; display: flex; flex-direction: column; gap: 2px; }
.helper-name { color: #ffb23e; font-weight: 700; }
.helper-say { color: #c7cfdb; font-size: 12px; line-height: 1.4; }

.feed { display: flex; gap: 6px; padding: 5px 8px; border-bottom: 1px solid #1a2130; font-size: 12px; }
.fclk { flex: none; width: 58px; color: #8892a6; font-variant-numeric: tabular-nums; }
.ftm { flex: none; width: 32px; font-weight: 700; }
.ftx { flex: 1; }

/* landscape on a short screen: tighter rows */
@media (orientation: landscape) and (max-height: 430px) {
  .row { padding: 2px 6px; }
  .pick-face, .icon { height: 26px; line-height: 26px; }
  .play { height: 30px; line-height: 30px; }
  .tab { height: 28px; line-height: 28px; }
}
