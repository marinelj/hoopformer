<template name="choiceMenu">
  <view class="choice-menu">
    <view class="choice-heading"><text>{{menu.title}}</text><view class="choice-close" aria-role="button" hover-class="pressed" bindtap="closeMenu">收起 ⌃</view></view>
    <view class="choice-options">
      <view wx:for="{{menu.options}}" wx:key="index" class="choice-option {{item.selected ? 'selected' : ''}}" data-index="{{item.index}}" aria-role="button" hover-class="pressed" bindtap="chooseMenu"><text>{{item.label}}</text><text class="choice-check">{{item.selected ? '✓' : '›'}}</text></view>
    </view>
  </view>
</template>
<view class="page {{landscape ? 'landscape' : 'portrait'}}">
  <view wx:if="{{!ready}}" class="loading">
    <text class="loading-title">场边教练</text><text class="loading-copy">{{error || '正在准备比赛…'}}</text>
    <button wx:if="{{error}}" class="primary" bindtap="retryStart">重新连接</button>
  </view>
  <view wx:if="{{ready}}" class="stage" style="width:{{courtW}}px">
    <view class="board">
      <view class="team"><text class="code">{{board.awayCode}}</text><text class="pts">{{board.awayPts}}</text></view>
      <view class="clocks"><text class="period">{{period}}</text><text class="clock">{{clock}}</text><text class="shot">进攻 {{shot}} 秒</text></view>
      <view class="team home"><text class="code">{{board.homeCode}}</text><text class="pts">{{board.homePts}}</text></view>
    </view>
    <view class="court-box" style="height:{{courtH}}px">
      <canvas type="2d" id="court" class="court" style="width:{{courtW}}px;height:{{courtH}}px" bindtap="tapCourt" bindtouchstart="pressCourt" bindtouchend="releaseControl" bindtouchcancel="releaseControl" aria-label="{{callout.show ? callout.big + '，' + callout.small : '比赛球场'}}"></canvas>
      <cover-view wx:if="{{playBounds.clear}}" class="play" style="opacity:0;left:{{playBounds.x}}px;top:{{playBounds.y}}px;width:{{playBounds.w}}px;height:{{playBounds.h}}px" aria-role="button" bindtap="pressPlay" bindtouchstart="pressControl" bindtouchend="releaseControl" bindtouchcancel="releaseControl">{{requestBusy ? '正在确认…' : playLabel}}</cover-view>
    </view>
    <view wx:if="{{strip}}" class="strip"><text>{{strip}}</text></view>
  </view>
  <view wx:if="{{ready}}" class="panel">
    <view class="tabs"><button class="tab {{tab === 'coach' ? 'on' : ''}}" data-tab="coach" bindtap="setTab">战术调整</button><button class="tab {{tab === 'plays' ? 'on' : ''}}" data-tab="plays" bindtap="setTab">比赛解说</button></view>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view>
    <text wx:if="{{soundMessage}}" class="voice-hint">{{soundMessage}}</text>
    <button wx:if="{{reconnectNeeded}}" class="reconnect" bindtap="retryStart">重新开赛</button>
    <view wx:if="{{tab === 'coach'}}" class="body">
      <view class="phase"><text>{{phaseLabel}}</text><text class="lock">{{locked ? '暂停后可改战术和任务' : '可调整战术和任务'}}</text></view>
      <view class="card team-card">
        <view class="card-heading"><text class="nm">全队</text><text class="kind">{{helper.say}}</text></view>
        <view class="fields">
          <view class="field pick-face tactic-choice {{locked ? 'disabled' : ''}}" data-kind="tactic" data-id="team" aria-role="button" hover-class="pressed" bindtap="openMenu"><text>{{tactics[tacticIndex].name}}</text><text>⌄</text></view>
          <view class="field pick-face call-choice {{teamCallIndex >= 0 ? 'has-call' : ''}}" data-kind="call" data-id="team" aria-role="button" hover-class="pressed" bindtap="openMenu"><text>{{teamCallLabel}}</text><text>⌄</text></view>
        </view>
        <template wx:if="{{menu && menu.id === 'team'}}" is="choiceMenu" data="{{menu}}" />
        <view wx:if="{{callout.show && callout.target === 'team'}}" class="row-reply {{callout.kind}}"><text>{{callout.big}}</text><text>{{callout.small}}</text></view>
        <view class="command-row">
          <button class="send own" size="mini" style="flex:0 0 57px;width:57px;min-width:0;max-width:57px;height:38px;line-height:38px;font-size:11px;padding:0;white-space:nowrap" disabled="{{sending || requestBusy}}" data-kind="say" data-id="team" bindtouchstart="gestureStart" catchtouchmove="voiceMove" bindtouchend="gestureEnd" bindtouchcancel="cancelGesture">队员 ←</button>
          <input class="command-input" data-id="team" value="{{teamDraft}}" bindinput="editDraft" placeholder="输入指令 · 长按两侧说话" maxlength="500" confirm-type="done" disabled="{{sending || (voiceStatus !== 'idle' && voiceTarget === 'team')}}"></input>
          <button class="send opponent" size="mini" style="flex:0 0 57px;width:57px;min-width:0;max-width:57px;height:38px;line-height:38px;font-size:11px;padding:0;white-space:nowrap" disabled="{{sending || requestBusy}}" data-kind="trash" data-id="team" bindtouchstart="gestureStart" catchtouchmove="voiceMove" bindtouchend="gestureEnd" bindtouchcancel="cancelGesture">→ 对手</button>
        </view>
        <text wx:if="{{voiceTarget === 'team' && voiceMessage}}" class="voice-message">{{voiceMessage}}</text>
      </view>
      <view class="card player-card" wx:for="{{rows}}" wx:key="id">
        <view class="card-heading"><text class="nm">{{item.name}}</text><text class="kind">{{item.kind}}</text></view>
        <view class="fields">
          <view class="field pick-face role-choice {{locked ? 'disabled' : ''}}" data-kind="role" data-id="{{item.id}}" aria-role="button" hover-class="pressed" bindtap="openMenu"><text>{{item.roleLabel}}</text><text>⌄</text></view>
          <view class="field pick-face call-choice {{item.callIndex >= 0 ? 'has-call' : ''}}" data-kind="call" data-id="{{item.id}}" aria-role="button" hover-class="pressed" bindtap="openMenu"><text>{{item.callLabel}}</text><text>⌄</text></view>
        </view>
        <template wx:if="{{menu && menu.id == item.id}}" is="choiceMenu" data="{{menu}}" />
        <view wx:if="{{callout.show && callout.target == item.id}}" class="row-reply {{callout.kind}}"><text>{{callout.big}}</text><text>{{callout.small}}</text></view>
        <view class="command-row">
          <button class="send own" size="mini" style="flex:0 0 57px;width:57px;min-width:0;max-width:57px;height:38px;line-height:38px;font-size:11px;padding:0;white-space:nowrap" disabled="{{sending || requestBusy}}" data-kind="say" data-id="{{item.id}}" bindtouchstart="gestureStart" catchtouchmove="voiceMove" bindtouchend="gestureEnd" bindtouchcancel="cancelGesture">队员 ←</button>
          <input class="command-input" data-id="{{item.id}}" value="{{item.draft}}" bindinput="editDraft" placeholder="输入指令 · 长按两侧说话" maxlength="500" confirm-type="done" disabled="{{sending || (voiceStatus !== 'idle' && voiceTarget === item.id)}}"></input>
          <button class="send opponent" size="mini" style="flex:0 0 57px;width:57px;min-width:0;max-width:57px;height:38px;line-height:38px;font-size:11px;padding:0;white-space:nowrap" disabled="{{sending || requestBusy}}" data-kind="trash" data-id="{{item.id}}" bindtouchstart="gestureStart" catchtouchmove="voiceMove" bindtouchend="gestureEnd" bindtouchcancel="cancelGesture">→ 对手</button>
        </view>
        <text wx:if="{{voiceTarget === item.id && voiceMessage}}" class="voice-message">{{voiceMessage}}</text>
      </view>
      <text class="voice-hint">{{voiceHint}}</text>
    </view>
    <view wx:if="{{tab === 'plays'}}" class="body">
      <view class="feed-empty" wx:if="{{!feed.length}}">比赛开始后，这里会记录投篮、篮板和换人。</view>
      <view class="feed" wx:for="{{feed}}" wx:key="key"><view class="feed-meta"><text>{{item.clock}}</text><text>{{item.team}}</text></view><text class="ftx">{{item.text}}</text></view>
    </view>
  </view>
</view>
